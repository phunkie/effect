{
    "name": "phunkie/effect",
    "description": "A functional effects library for PHP inspired by Scala's cats-effect",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Marcello Duarte",
            "email": "marcello.duarte@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "phunkie/phunkie": "^1.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phunkie/console": "^1.0.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.75"
    },
    "suggest": {
        "ext-parallel": "Required for parallel execution using threads. PHP must be compiled with ZTS support."
    },
    "autoload": {
        "psr-4": {
            "Phunkie\\Effect\\": "src/"
        },
        "files": [
            "src/Functions/common.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Unit\\Phunkie\\Effect\\": "tests/Unit/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-fix": "php-cs-fixer fix --allow-risky=yes",
        "cs-check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "lint": [
            "@cs-check",
            "@phpstan"
        ],
        "test-all": "scripts/test-all-versions.sh",
        "check": [
            "@lint",
            "@test"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "bin-dir": "bin"
    }
}